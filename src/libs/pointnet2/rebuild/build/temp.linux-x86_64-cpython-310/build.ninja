cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /localhome/ava40/miniconda3/include -fPIC -O2 -isystem /localhome/ava40/miniconda3/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /localhome/ava40/miniconda3/include -I/localhome/ava40/miniconda3/targets/x86_64-linux/include -L/localhome/ava40/miniconda3/targets/x86_64-linux/lib -L/localhome/ava40/miniconda3/targets/x86_64-linux/lib/stubs -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /localhome/ava40/miniconda3/include -I/localhome/ava40/miniconda3/targets/x86_64-linux/include -L/localhome/ava40/miniconda3/targets/x86_64-linux/lib -L/localhome/ava40/miniconda3/targets/x86_64-linux/lib/stubs -fPIC -I/localhome/ava40/miniconda3/lib/python3.10/site-packages/torch/include -I/localhome/ava40/miniconda3/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/localhome/ava40/miniconda3/include -I/localhome/ava40/miniconda3/include/python3.10 -c
